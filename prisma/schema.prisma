datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String             @id @default(cuid())
  walletAddress   String             @unique
  xHandle         String?            @unique
  status          String             @default("ACTIVE") // ACTIVE, PENDING, BANNED
  isBanned        Boolean            @default(false)
  email           String?
  avatarUrl       String?
  referralCode    String             @unique
  referredBy      String?
  totalPoints     Int                @default(0)
  role            String             @default("USER") // USER, ADMIN
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  submissions     QuestSubmission[]
  pointsHistory   PointsTransaction[]
  referralsMade   Referral[]         @relation("Referrer")
  referredEntry   Referral?          @relation("Referee")
}

model Quest {
  id                String            @id @default(cuid())
  slug              String            @unique
  orderIndex        Int               @default(0)
  title             String
  description       String
  taskType          String            // FOLLOW_X, LIKE_X, REPOST_X, COMMENT_X, WALLET_CONNECT, VISIT_URL, DISCORD, TELEGRAM, CUSTOM
  url               String?
  points            Int               @default(100)
  verificationType  String            @default("HANDLE") // HANDLE, LINK, WALLET, AUTO, MANUAL
  isActive          Boolean           @default(true)
  metadata          String?           // JSON string for additional config
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  submissions       QuestSubmission[]
}

model QuestSubmission {
  id              String            @id @default(cuid())
  userId          String?
  questId         String
  walletAddress   String
  submittedData   String            // Handle, comment URL, etc.
  status          String            @default("APPROVED") // PENDING, APPROVED, REJECTED
  pointsAwarded   Int               @default(0)
  proofUrl        String?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User?             @relation(fields: [userId], references: [id])
  quest           Quest             @relation(fields: [questId], references: [id])
}

model PointsTransaction {
  id              String            @id @default(cuid())
  userId          String
  amount          Int
  type            String            // QUEST_REWARD, WAITLIST_REWARD, REFERRAL_BONUS, ADMIN_ADJUSTMENT, STAKING_REWARD
  description     String
  referenceId     String?
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id])
}

model Referral {
  id              String            @id @default(cuid())
  referrerId      String
  refereeId       String            @unique
  referralCode    String
  pointsEarned    Int               @default(100)
  status          String            @default("COMPLETED")
  createdAt       DateTime          @default(now())

  referrer        User              @relation("Referrer", fields: [referrerId], references: [id])
  referee         User              @relation("Referee", fields: [refereeId], references: [id])
}

model MintSettings {
  id              String            @id @default("default")
  isActive        Boolean           @default(false)
  priceEth        Float             @default(0.08)
  maxSupply       Int               @default(3333)
  mintedCount     Int               @default(1420)
  maxPerWallet    Int               @default(3)
  contractAddress String            @default("0x0000000000000000000000000000000000000000")
  chain           String            @default("Ethereum Mainnet")
  chainId         Int               @default(1)
  startDate       DateTime?
  endDate         DateTime?
  updatedAt       DateTime          @updatedAt
}

model StakingSettings {
  id                String          @id @default("default")
  isActive          Boolean         @default(false)
  apyPercent        Float           @default(38.5)
  minStake          Float           @default(0.1)
  maxStake          Float           @default(100.0)
  lockDurationDays  Int             @default(30)
  rewardTokenSymbol String          @default("$STONKS")
  contractAddress   String          @default("0x0000000000000000000000000000000000000000")
  chain             String          @default("Ethereum Mainnet")
  chainId           Int             @default(1)
  totalStaked       Float           @default(450.5)
  updatedAt         DateTime        @updatedAt
}

model SiteSettings {
  id                  String        @id @default("default")
  projectName         String        @default("Hype Stonks")
  tagline             String        @default("Trade the Hype. Earn Your Position.")
  logoUrl             String        @default("/logo.svg")
  twitterUrl          String        @default("https://x.com/HypeStonks")
  discordUrl          String        @default("https://discord.gg/hypestonks")
  telegramUrl         String        @default("https://t.me/hypestonks")
  websiteUrl          String        @default("https://hype-stonks.io")
  maintenanceMode     Boolean       @default(false)
  questsEnabled       Boolean       @default(true)
  mintEnabled         Boolean       @default(false)
  stakingEnabled      Boolean       @default(false)
  referralsEnabled    Boolean       @default(true)
  referralRewardPoints Int          @default(250)
  maxReferralRewards  Int           @default(10000)
  hcaptchaSiteKey     String?
  updatedAt           DateTime      @updatedAt
}

model AdminUser {
  id              String            @id @default(cuid())
  username        String            @unique
  passwordHash    String
  role            String            @default("SUPERADMIN")
  createdAt       DateTime          @default(now())
}

model ActivityLog {
  id              String            @id @default(cuid())
  actor           String
  action          String
  details         String
  ipAddress       String?
  createdAt       DateTime          @default(now())
}
